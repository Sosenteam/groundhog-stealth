offset_bottom = 281.0
theme_override_fonts/font = ExtResource("2_0tslw")
theme_override_font_sizes/font_size = 11
text = "Who He Was: Clifford Gibson (April 17, 1901 – December 21, 1963) was an influential American blues singer and guitarist."
horizontal_alignment = 1
autowrap_mode = 3

[node name="T3" type="Label" parent="." unique_id=505264584]
offset_left = -320.0
offset_top = -281.0
offset_right = -12.0
offset_bottom = -125.0
theme_override_fonts/font = ExtResource("2_0tslw")
theme_override_font_sizes/font_size = 11
text = "The St. Louis Blues Scene: He was a major figure in the St. Louis blues scene during the late 1920s and 1930s. He was known for his distinct, clean, and highly skilled fingerpicking guitar style."
horizontal_alignment = 1
autowrap_mode = 3

[node name="T4" type="Label" parent="." unique_id=199089271]
offset_left = -566.0
offset_top = -76.0
offset_right = -147.0
offset_bottom = 81.0
theme_override_fonts/font = ExtResource("2_0tslw")
theme_override_font_sizes/font_size = 11
text = "Fun Fact: Unlike many blues musicians of his era who traveled constantly, Gibson spent most of his life and career playing in the clubs and streets of St. Louis, Missouri. Later in life, he was known to play music on the streets accompanied by a pet dog that would collect tips from onlookers."
horizontal_alignment = 1
autowrap_mode = 3

[node name="T6" type="Label" parent="." unique_id=1893953472]
offset_left = 206.0
offset_top = 129.0
offset_right = 401.0
offset_bottom = 222.0
theme_override_fonts/font = ExtResource("2_0tslw")
theme_override_font_sizes/font_size = 11
text = "The Recording Date: The song was recorded on December 18, 1951, at Baul Studios in St. Louis."
horizontal_alignment = 1
autowrap_mode = 3

[node name="T7" type="Label" parent="." unique_id=1817028813]
offset_left = 193.0
offset_top = -84.0
offset_right = 534.0
offset_bottom = 69.0
theme_override_fonts/font = ExtResource("2_0tslw")
theme_override_font_sizes/font_size = 11
text = "The Mystery Track: \"Sneaky Groundhog\" is a rare piece of music history because it was never actually released when it was recorded. The studio session went unissued, meaning the audio was essentially \"lost\" to the public for decades."
horizontal_alignment = 1
autowrap_mode = 3

[node name="T8" type="Label" parent="." unique_id=878672787]
offset_left = 41.0
offset_top = -288.0
offset_right = 407.0
offset_bottom = -135.0
theme_override_fonts/font = ExtResource("2_0tslw")
theme_override_font_sizes/font_size = 11
text = "The 1989 Rescue: The track was finally rediscovered and released in 1989 by an archival record label called Swingtime Records on a compilation album titled Times Are So Tight. Because it was saved from old studio tapes, it survived for future generations to hear."
horizontal_alignment = 1
autowrap_mode = 3

[node name="T11" type="Label" parent="." unique_id=1210323702]
offset_left = -124.0
offset_top = 33.0
offset_right = 121.0
offset_bottom = 134.0
theme_override_fonts/font = ExtResource("2_0tslw")
theme_override_font_sizes/font_size = 11
text = "Music Credits & Attribution
Track: \"Sneaky Groundhog\" (Recorded 1951, Released 1989)
Artist: Clifford Gibson"
horizontal_alignment = 1
autowrap_mode = 3


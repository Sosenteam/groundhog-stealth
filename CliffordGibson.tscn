[node name="T12" type="Label" parent="." unique_id=315341318]
offset_left = -110.0
offset_top = 140.0
offset_right = 103.0
offset_bottom = 497.0
theme_override_fonts/font = ExtResource("2_0tslw")
theme_override_font_sizes/font_size = 11
text = "Historical Note: This project proudly features the music of St. Louis blues legend Clifford Gibson. Because this tracking is a historically unissued \"Orphan Work\" with no active commercial publisher or estate, it is utilized here strictly for non-profit, educational purposes under Educational Fair Use guidelines. Special thanks to the archivists who preserved this piece of American music history."
horizontal_alignment = 1
autowrap_mode = 3

